---

<div class="draft-banner">

    <div class="draft-title">
        DRAFT COUNTDOWN
    </div>

    <div class="countdown-grid">

        <div class="time-box">
            <span id="days">000</span>
            <small>DAYS</small>
        </div>

        <div class="time-box">
            <span id="hours">00</span>
            <small>HOURS</small>
        </div>

        <div class="time-box">
            <span id="minutes">00</span>
            <small>MINUTES</small>
        </div>

        <div class="time-box">
            <span id="seconds">00</span>
            <small>SECONDS</small>
        </div>

    </div>

    <div class="draft-info">
        Saturday, September 5, 2026 • 5:00 PM CDT
    </div>

    <div class="draft-address">
        1245 Club Road, Woodstock, IL 60098
    </div>

</div>

<script is:inline>

window.addEventListener("DOMContentLoaded", () => {

    const draftDate = new Date("2026-09-05T17:00:00");

    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");
    const countdownGrid = document.querySelector(".countdown-grid");

    if (
        !daysEl ||
        !hoursEl ||
        !minutesEl ||
        !secondsEl ||
        !countdownGrid
    ) {
        return;
    }

    function updateCountdown() {

        const now = new Date();

        const diff = draftDate.getTime() - now.getTime();

        if (diff <= 0) {

            countdownGrid.innerHTML =
                "<h2>THE DRAFT IS HERE!</h2>";

            return;

        }

        const dayValue = Math.floor(diff / (1000 * 60 * 60 * 24));

        const hourValue = Math.floor(
            (diff % (1000 * 60 * 60 * 24)) /
            (1000 * 60 * 60)
        );

        const minuteValue = Math.floor(
            (diff % (1000 * 60 * 60)) /
            (1000 * 60)
        );

        const secondValue = Math.floor(
            (diff % (1000 * 60)) / 1000
        );

        daysEl.textContent = String(dayValue).padStart(3, "0");
        hoursEl.textContent = String(hourValue).padStart(2, "0");
        minutesEl.textContent = String(minuteValue).padStart(2, "0");
        secondsEl.textContent = String(secondValue).padStart(2, "0");

    }

    updateCountdown();

    setInterval(updateCountdown, 1000);

});

</script>

<style>

.draft-banner{

    width:100%;
    background:#D4AF37;
    color:#111;

    text-align:center;

    padding:28px 18px;

    box-shadow:0 4px 12px rgba(0,0,0,.25);

}

.draft-title{

    font-size:clamp(1.4rem,3vw,2.2rem);

    font-weight:900;

    letter-spacing:2px;

    margin-bottom:24px;

}

.countdown-grid{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:14px;

    width:min(650px,95%);

    margin:0 auto;

}

.time-box{

    background:#111;

    color:white;

    width:100%;

    border:2px solid #B08D2C;

    border-radius:12px;

    padding:14px 8px;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    min-height:100px;

    box-shadow:0 6px 16px rgba(0,0,0,.35);

}

.time-box span{

    display:block;

    font-size:clamp(1.7rem,4vw,2.6rem);

    font-weight:900;

    line-height:1;

    color:#D4AF37;

}

.time-box small{

    margin-top:8px;

    font-size:clamp(.55rem,1.3vw,.8rem);

    letter-spacing:1px;

    font-weight:700;

}

.draft-info{

    margin-top:24px;

    font-size:clamp(.95rem,2vw,1.2rem);

    font-weight:700;

}

.draft-address{

    margin-top:8px;

    font-size:clamp(.85rem,1.8vw,1rem);

    font-weight:600;

}

@media (max-width:600px){

    .countdown-grid{

        gap:8px;

        width:98%;

    }

    .time-box{

        padding:10px 4px;

        min-height:82px;

    }

}

</style>