---
import { league } from "../data/league";

/*
  Sort by race finish once results are available.
  Until then, sort by qualifying position.
*/
const raceStandings = [...league].sort((a, b) => {
  const aPosition =
    a.finishingPosition ?? a.qualifyingPosition;

  const bPosition =
    b.finishingPosition ?? b.qualifyingPosition;

  return aPosition - bPosition;
});
---

<section class="league-card">

  <h2>
    Get fucking ready for the IOWA CORN 350 on Sunday August 9th!
    Who's gonna get Bijan? We will start picking draft spots one by one
    according to our drivers finishing order after the race.
  </h2>

  <table>
    <thead>
      <tr>
        <th>Manager</th>
        <th>NASCAR Driver</th>
        <th>Qual.</th>
        <th>Finish</th>
        <th>Draft Pos.</th>
      </tr>
    </thead>

    <tbody>
      {raceStandings.map((member) => (
        <tr>
          <td>{member.manager}</td>

          <td class="nascar-driver">
            {member.nascar}
          </td>

          <td>
            {member.qualifyingPosition}
          </td>

          <td>
            {member.finishingPosition}
          </td>

          <td>
            {member.draftPosition ?? "—"}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

</section>