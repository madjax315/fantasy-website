  { manager: "Taylor", driver: "Shane van Gisbergen" },
  { manager: "Shawn", driver: "Michael McDowell" },
  { manager: "Keen", driver: "Ross Chastain" },
  { manager: "Colin", driver: "Daniel Suárez" },
  { manager: "Jas", driver: "Austin Cindric" },
  { manager: "Chris", driver: "AJ Allmendinger" },
  { manager: "Evan", driver: "John H Nemecheck" },
  { manager: "Matt", driver: "Austin Dillon" },
  { manager: "Dev", driver: "Ricky Stenhouse Jr." },
  { manager: "Ryan", driver: "Erik Jones" },
