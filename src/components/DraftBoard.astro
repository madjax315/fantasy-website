---
import { draftOrder, keepers } from "../data/pre-draft-2026";

const rounds = Array.from({ length: 16 }, (_, i) => i + 1);

function getRoundOrder(round: number) {
  return round % 2 === 1
    ? draftOrder
    : [...draftOrder].reverse();
}
---

<section class="draft-section">
  <div class="draft-header">
    <p class="eyebrow">2026 SEASON</p>
    <h2>Draft Board</h2>
    <p class="subtitle">
      Official draft order and keeper selections
    </p>
  </div>

  <div class="board-scroll">
    <div class="draft-board">

      <div class="corner-cell">
        RD
      </div>

      {
        draftOrder.map((manager, index) => (
          <div class="manager-header">
            <span class="draft-position">
              {index + 1}
            </span>

            <span>{manager}</span>
          </div>
        ))
      }

      {
        rounds.map((round) => {
          const roundOrder = getRoundOrder(round);

          return (
            <>
              <div class="round-number">
                {round}
              </div>

              {
                draftOrder.map((manager) => {
                  const keeper = keepers[manager]?.[round];

                  const pickInRound =
                    roundOrder.indexOf(manager) + 1;

                  const overallPick =
                    (round - 1) * draftOrder.length +
                    pickInRound;

                  return (
                    <div
                      class:list={[
                        "draft-cell",
                        keeper && "keeper-cell"
                      ]}
                    >
                      <span class="pick-number">
                        {overallPick}
                      </span>

                      {
                        keeper ? (
                          <>
                            <span class="keeper-name">
                              {keeper}
                            </span>

                            <span class="keeper-label">
                              KEEPER
                            </span>
                          </>
                        ) : (
                          <span class="empty-pick">
                            —
                          </span>
                        )
                      }
                    </div>
                  );
                })
              }
            </>
          );
        })
      }

    </div>
  </div>

  <div class="legend">
    <span class="legend-box"></span>
    Keeper Selection
  </div>
</section>

<style>
  .draft-order {
    width: min(520px, calc(100% - 30px));
    margin: 28px auto;
    background: #151515;
    border: 1px solid #b08d2c;
    border-radius: 8px;
    overflow: hidden;
  }

  /* HEADER */

  .header {
    text-align: center;
    padding: 16px;
    background: #090909;
  }

  .eyebrow {
    color: #b08d2c;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin: 0 0 3px;
  }

  h2 {
    color: #d4af37;
    font-size: 20px;
    margin: 0;
  }

  /* ON THE CLOCK */

  .on-clock {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 9px;

    background: #d4af37;
    color: #090909;
  }

  .on-clock span {
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .on-clock strong {
    font-size: 14px;
  }

  .on-clock small {
    font-size: 9px;
    font-weight: 700;
  }

  /* TABLE */

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    background: #090909;
    color: #b08d2c;

    padding: 7px;

    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  td {
    padding: 8px 8px;
    text-align: center;

    border-bottom: 1px solid #333;

    color: #d5d5d5;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  /* DRAFT POSITION */

  .draft-pick {
    width: 25%;

    color: #d4af37;

    font-size: 15px;
    font-weight: 900;
  }

  /* MANAGER */

  .manager {
    width: 50%;

    font-size: 12px;
    font-weight: 700;
  }

  /* PRIORITY */

  .priority {
    width: 25%;

    font-size: 11px;
  }

  /* FILLED DRAFT POSITIONS */

  .selected {
    background: #1d1d1d;
  }

  .selected .manager {
    color: #ffffff;
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .draft-order {
      width: calc(100% - 20px);
      margin: 18px auto;
    }

    .header {
      padding: 13px 8px;
    }

    h2 {
      font-size: 18px;
    }

    .on-clock {
      gap: 6px;
      padding: 8px 4px;
    }

    .on-clock span {
      font-size: 7px;
    }

    .on-clock strong {
      font-size: 13px;
    }

    .on-clock small {
      font-size: 9px;
    }

    th {
      padding: 7px 3px;
      font-size: 7px;
    }

    td {
      padding: 7px 3px;
    }

    .draft-pick {
      font-size: 15px;
    }

    .manager {
      font-size: 12px;
    }

    .priority {
      font-size: 10px;
    }
  }
</style>